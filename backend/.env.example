# Supabase (from `supabase start` output, or your cloud project settings)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# LLM persona — provider-agnostic, OpenAI-compatible. Default: Groq free tier.
# Get a free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# External data sources (free tiers)
ODDS_API_KEY=
API_FOOTBALL_KEY=

ENVIRONMENT=development
